# ==========================================================================
# AO-BTP Copilot — Clés API pour le benchmark des modèles LLM
# ==========================================================================
#
# Où obtenir chaque clé :
#   - GEMINI_API_KEY : https://aistudio.google.com/apikey  (gratuit, ~1500 RPD,
#     modèle gemini-3.5-flash libre)
#   - GROQ_API_KEY  : https://console.groq.com/keys         (gratuit, sans carte,
#     API compatible OpenAI, modèle openai/gpt-oss-120b)
#   - (facultatif, à venir) OLLAMA — pas de clé : Ollama tourne EN LOCAL.
#
# Laissez vide les clés que vous n'avez pas : le notebook listera les modèles
# testables et ignorera les fournisseurs sans clé.

GEMINI_API_KEY=
GROQ_API_KEY=

