# Copier ce fichier en « .env » à côté de docker-compose.yml puis remplacer JWT_SECRET.
# Générer un secret :  python -c "import secrets; print(secrets.token_hex(32))"

# Secret JWT en production (obligatoire, >= 32 octets). Sans lui, la valeur de
# développement est utilisée — NE PAS laisser ainsi en ligne.
JWT_SECRET=remplacer-par-un-secret-long-aleatoire-32-octets-minimum

# Durée de validité des tokens (minutes, défaut 12 h)
JWT_EXP_MINUTES=4320